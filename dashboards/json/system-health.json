    {
      "type": "stat",
      "title": "Protocol violations, last 7 days",
      "description": "Late predictions rejected by the database clock, chain breaks and permission denials (Quadro 9).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cryptonlp-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(sum(violations), 0) AS violations FROM monitoring.ledger_violations WHERE day > now() - interval '7 days'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
