          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cryptonlp-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT source, sum(posts) AS posts FROM monitoring.posts_per_hour WHERE hour > now() - interval '24 hours' GROUP BY source ORDER BY source"
        }
