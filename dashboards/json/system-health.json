    {
      "type": "stat",
      "title": "Last chain check",
      "description": "The daily job recomputes every hash and link, and checks every anchor sent to the advisor. A break is also written to the ledger as a violation.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cryptonlp-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN ok THEN 1 ELSE 0 END AS intact FROM monitoring.ledger_checks ORDER BY checked_at DESC LIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "broken",
                  "index": 0
                },
                "1": {
                  "text": "intact",
                  "index": 1
                }
              }
            }
          ],
          "noValue": "never run"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
