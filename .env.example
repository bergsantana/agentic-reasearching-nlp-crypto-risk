# Copy to .env (git-ignored) and change the passwords.
POSTGRES_USER=cryptonlp
POSTGRES_PASSWORD=cryptonlp
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433

# Real database: collectors, ledger, labels. Never used by tests or CI.
CRYPTONLP_DATABASE_URL=postgresql://cryptonlp:cryptonlp@127.0.0.1:5432/cryptonlp
# Test database: the only one tests, CI and the simulated clock may use. Its name must end in _test.
CRYPTONLP_TEST_DATABASE_URL=postgresql://cryptonlp:cryptonlp@127.0.0.1:5433/cryptonlp_test

# Step 1: collectors and monitoring
# Your user and group IDs (id -u, id -g), so files the containers write in data/ stay yours.
UID=1000
GID=1000
# Grafana: admin login (http://127.0.0.1:3000) and the read-only database role it uses.
GRAFANA_ADMIN_PASSWORD=admin
CRYPTONLP_GRAFANA_DB_PASSWORD=grafana
# Alerts go to Telegram: create a bot with @BotFather, send it a message, then read the chat
# ID from https://api.telegram.org/bot<token>/getUpdates. Until set, alerts are not delivered.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Record every collector's messages to data/replay/<day>/ for the frozen replay day.
CRYPTONLP_RECORD_REPLAY=false
