# Copy to .env (git-ignored) and change the passwords.
POSTGRES_USER=cryptonlp
POSTGRES_PASSWORD=cryptonlp
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433

# Real database: collectors, ledger, labels. Never used by tests or CI.
CRYPTONLP_DATABASE_URL=postgresql://cryptonlp:cryptonlp@127.0.0.1:5432/cryptonlp
# Test database: the only one tests, CI and the simulated clock may use. Its name must end in _test.
CRYPTONLP_TEST_DATABASE_URL=postgresql://cryptonlp:cryptonlp@127.0.0.1:5433/cryptonlp_test

# Step 1: collectors and monitoring
# Your user and group IDs (id -u, id -g), so files the containers write in data/ stay yours.
UID=1000
GID=1000
# Grafana: admin login (http://127.0.0.1:3000) and the read-only database role it uses.
GRAFANA_ADMIN_PASSWORD=admin
CRYPTONLP_GRAFANA_DB_PASSWORD=grafana
# Alerts go to Telegram: create a bot with @BotFather, send it a message, then read the chat
# ID from https://api.telegram.org/bot<token>/getUpdates. Until set, alerts are not delivered.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Record every collector's messages to data/replay/<day>/ for the frozen replay day.
CRYPTONLP_RECORD_REPLAY=false

# Step 3: pseudonymization key (HMAC for author IDs), outside the repository. Create it once with
# `uv run cryptonlp keygen` and back it up: a new key gives every author a new hash.
# CRYPTONLP_PSEUDONYM_KEY_FILE=/home/you/.config/cryptonlp/pseudonym.key   # for the CLI
# CRYPTONLP_PSEUDONYM_KEY_HOST_FILE=/home/you/.config/cryptonlp/pseudonym.key  # for Compose

# Step 3b: schedule the hourly forecast loop (minute 25) in the scheduler. Leave it off in
# development except during a smoke run: every forecast and score it writes stays in the ledger.
CRYPTONLP_FORECAST_LOOP=false

# Step 4: Label Studio (http://127.0.0.1:8080). The account below is created on its first start.
LABEL_STUDIO_USERNAME=researcher@localhost
LABEL_STUDIO_PASSWORD=change-me-now
CRYPTONLP_LABEL_STUDIO_DB_PASSWORD=labelstudio
# A personal access token: log in, then Account & Settings > Personal Access Token. With it set,
# the scheduler copies annotations out of Label Studio every hour.
CRYPTONLP_LABEL_STUDIO_API_KEY=

# Step 5: MLflow (http://127.0.0.1:5000), for the walk-forward runs. The CLI on the host uses this
# address; services inside Compose use http://mlflow:5000.
CRYPTONLP_MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Step 6: SemIf and the embeddings on vLLM (`docker compose --profile gpu up -d --wait`). Ports of
# the two servers on the host, and their share of the 16 GB GPU (both together fit; the bake-off's
# hf-scorer needs them stopped).
SEMIF_PORT=8001
EMBED_PORT=8002
SEMIF_GPU_MEMORY=0.74
EMBED_GPU_MEMORY=0.20
# Embed new in-study posts every hour in the scheduler (needs the `embed` server up).
CRYPTONLP_EMBEDDINGS=false
